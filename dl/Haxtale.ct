--============================================
-- MAIN FORM CREATION
--============================================

local mainForm = createForm()
mainForm.BorderStyle = bsNone
mainForm.Width = 440
mainForm.Height = 560
mainForm.Position = poScreenCenter
mainForm.Color = 0x0D0D0D

-- Drag state variables
local isDragging = false
local dragStartX, dragStartY = 0, 0
local formStartLeft, formStartTop = 0, 0

-- State variables
local isTeleporting = false
local cancelTeleport = false
local isConnected = false
local processId = nil
local currentTab = 1

function startDrag(x, y)
    isDragging = true
    dragStartX = x
    dragStartY = y
    formStartLeft = mainForm.Left
    formStartTop = mainForm.Top
end

function doDrag(x, y)
    if isDragging then
        mainForm.Left = formStartLeft + x - dragStartX
        mainForm.Top = formStartTop + y - dragStartY
    end
end

function stopDrag()
    isDragging = false
end


--============================================
-- UI HELPER FUNCTIONS
--============================================

function createToggleButton(parent, title, yPos, cheatKey, hotkey)
    local panel = createPanel(parent)
    panel.Left = 20
    panel.Top = yPos
    panel.Width = 400
    panel.Height = 50
    panel.Color = 0x151515
    panel.BevelOuter = "bvNone"

    local accentBar = createPanel(panel)
    accentBar.Left = 0
    accentBar.Top = 0
    accentBar.Width = 4
    accentBar.Height = 50
    accentBar.Color = 0x252525
    accentBar.BevelOuter = "bvNone"

    local titleLbl = createLabel(panel)
    titleLbl.Caption = title
    titleLbl.Left = 20
    titleLbl.Top = 10
    titleLbl.Font.Size = 11
    titleLbl.Font.Style = "[fsBold]"
    titleLbl.Font.Color = 0xDDDDDD
    titleLbl.Transparent = true

    local hotkeyLabel = createLabel(panel)
    hotkeyLabel.Caption = hotkey and ("Hotkey: " .. hotkey) or ""
    hotkeyLabel.Left = 20
    hotkeyLabel.Top = 30
    hotkeyLabel.Font.Size = 8
    hotkeyLabel.Font.Color = 0x555555
    hotkeyLabel.Transparent = true

    local toggleButton = createButton(panel)
    toggleButton.Caption = "OFF"
    toggleButton.Left = 320
    toggleButton.Top = 10
    toggleButton.Width = 65
    toggleButton.Height = 30
    toggleButton.Font.Size = 10
    toggleButton.Font.Style = "[fsBold]"
    toggleButton.Color = 0x1F1F1F
    toggleButton.Font.Color = 0x606060
    toggleButton.OnClick = function()
        cheatsEnabled[cheatKey] = not cheatsEnabled[cheatKey]
        if cheatsEnabled[cheatKey] then
            toggleButton.Caption = "ON"
            toggleButton.Font.Color = 0x55FF55
            accentBar.Color = 0xDC5EFF
        else
            toggleButton.Caption = "OFF"
            toggleButton.Font.Color = 0x606060
            accentBar.Color = 0x252525
        end
    end

    return {
        panel = panel,
        button = toggleButton,
        accent = accentBar,
        label = titleLbl
    }
end

function createSliderPanel(parent, title, yPos, minVal, maxVal, defaultVal, onChange)
    local panel = createPanel(parent)
    panel.Left = 20
    panel.Top = yPos
    panel.Width = 400
    panel.Height = 65
    panel.Color = 0x151515
    panel.BevelOuter = "bvNone"

    local accentBar = createPanel(panel)
    accentBar.Left = 0
    accentBar.Top = 0
    accentBar.Width = 4
    accentBar.Height = 65
    accentBar.Color = 0x252525
    accentBar.BevelOuter = "bvNone"

    local titleLbl = createLabel(panel)
    titleLbl.Caption = title
    titleLbl.Left = 20
    titleLbl.Top = 8
    titleLbl.Font.Size = 10
    titleLbl.Font.Style = "[fsBold]"
    titleLbl.Font.Color = 0xDDDDDD
    titleLbl.Transparent = true

    local valueLabel = createLabel(panel)
    valueLabel.Caption = tostring(defaultVal)
    valueLabel.Left = 360
    valueLabel.Top = 8
    valueLabel.Width = 30
    valueLabel.Font.Size = 11
    valueLabel.Font.Style = "[fsBold]"
    valueLabel.Font.Color = 0xDC5EFF
    valueLabel.Alignment = "taRightJustify"
    valueLabel.Transparent = true

    local trackBar = createTrackBar(panel)
    trackBar.Left = 20
    trackBar.Top = 32
    trackBar.Width = 360
    trackBar.Height = 25
    trackBar.Min = minVal
    trackBar.Max = maxVal
    trackBar.Position = defaultVal
    trackBar.OnChange = function()
        valueLabel.Caption = tostring(trackBar.Position)
        if onChange then
            onChange(trackBar.Position)
        end
    end

    return {
        panel = panel,
        track = trackBar,
        valueLabel = valueLabel,
        accent = accentBar
    }
end


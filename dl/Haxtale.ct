--============================================
-- WAYPOINTS WINDOW
--============================================

local waypointsForm = nil
local serverComboBox = nil
local waypointListBox = nil

function refreshServerList()
    if serverComboBox then
        serverComboBox.Items.clear()
        for _, serverName in ipairs(getServerList()) do
            serverComboBox.Items.add(serverName)
        end

        local index = serverComboBox.Items.indexOf(currentServer)
        if index &gt;= 0 then
            serverComboBox.ItemIndex = index
        elseif serverComboBox.Items.Count &gt; 0 then
            serverComboBox.ItemIndex = 0
            currentServer = serverComboBox.Items[0]
        end
    end
end

function refreshWaypointList()
    if waypointListBox and currentServer then
        waypointListBox.Items.clear()
        if waypointsData[currentServer] then
            for i, waypoint in ipairs(waypointsData[currentServer]) do
                waypointListBox.Items.add(string.format("%s (%.0f, %.0f, %.0f)", waypoint.name, waypoint.x, waypoint.y, waypoint.z))
            end
        end
    end
end

function showWaypointsWindow()
    if waypointsForm then
        waypointsForm.show()
        refreshServerList()
        refreshWaypointList()
        return
    end

    waypointsForm = createForm(false)
    waypointsForm.Caption = "Waypoints Manager"
    waypointsForm.Width = 350
    waypointsForm.Height = 420
    waypointsForm.Position = poScreenCenter
    waypointsForm.Color = 0x0D0D0D
    waypointsForm.BorderStyle = bsNone

    -- Header
    local wpHeader = createPanel(waypointsForm)
    wpHeader.Left = 0
    wpHeader.Top = 0
    wpHeader.Width = 350
    wpHeader.Height = 50
    wpHeader.Color = 0x0D0D0D
    wpHeader.BevelOuter = "bvNone"

    local wpAccent = createPanel(wpHeader)
    wpAccent.Left = 0
    wpAccent.Top = 0
    wpAccent.Width = 350
    wpAccent.Height = 3
    wpAccent.Color = 0xDC5EFF
    wpAccent.BevelOuter = "bvNone"

    local wpTitle = createLabel(wpHeader)
    wpTitle.Caption = "WAYPOINTS MANAGER"
    wpTitle.Left = 15
    wpTitle.Top = 14
    wpTitle.Font.Size = 14
    wpTitle.Font.Style = "[fsBold]"
    wpTitle.Font.Color = 0xDC5EFF
    wpTitle.Transparent = true

    local wpCloseButton = createLabel(wpHeader)
    wpCloseButton.Caption = "X"
    wpCloseButton.Left = 320
    wpCloseButton.Top = 10
    wpCloseButton.Width = 25
    wpCloseButton.Height = 25
    wpCloseButton.Font.Size = 12
    wpCloseButton.Font.Style = "[fsBold]"
    wpCloseButton.Font.Color = 0xFF5555
    wpCloseButton.Alignment = "taCenter"
    wpCloseButton.Transparent = true
    wpCloseButton.OnClick = function()
        waypointsForm.hide()
    end

    -- Drag functionality for waypoints window
    local wpDragging = false
    local wpDragStartX, wpDragStartY = 0, 0
    local wpFormStartLeft, wpFormStartTop = 0, 0

    local function wpStartDrag(x, y)
        wpDragging = true
        wpDragStartX = x
        wpDragStartY = y
        wpFormStartLeft = waypointsForm.Left
        wpFormStartTop = waypointsForm.Top
    end

    local function wpDoDrag(x, y)
        if wpDragging then
            waypointsForm.Left = wpFormStartLeft + x - wpDragStartX
            waypointsForm.Top = wpFormStartTop + y - wpDragStartY
        end
    end

    local function wpStopDrag()
        wpDragging = false
    end

    wpHeader.OnMouseDown = function(sender, button, x, y)
        if button == mbLeft then
            wpStartDrag(waypointsForm.Left + x, waypointsForm.Top + y)
        end
    end

    wpHeader.OnMouseMove = function(sender, x, y)
        wpDoDrag(waypointsForm.Left + x, waypointsForm.Top + y)
    end

    wpHeader.OnMouseUp = function(sender, button)
        if button == mbLeft then
            wpStopDrag()
        end
    end

    wpTitle.OnMouseDown = function(sender, button, x, y)
        if button == mbLeft then
            wpStartDrag(waypointsForm.Left + wpTitle.Left + x, waypointsForm.Top + wpTitle.Top + y)
        end
    end

    wpTitle.OnMouseMove = function(sender, x, y)
        wpDoDrag(waypointsForm.Left + wpTitle.Left + x, waypointsForm.Top + wpTitle.Top + y)
    end

    wpTitle.OnMouseUp = function(sender, button)
        if button == mbLeft then
            wpStopDrag()
        end
    end

    -- Content Panel
    local wpContent = createPanel(waypointsForm)
    wpContent.Left = 0
    wpContent.Top = 50
    wpContent.Width = 350
    wpContent.Height = 370
    wpContent.Color = 0x0D0D0D
    wpContent.BevelOuter = "bvNone"

    -- Server/Folder section
    local serverLabel = createLabel(wpContent)
    serverLabel.Caption = "SERVER / FOLDER"
    serverLabel.Left = 15
    serverLabel.Top = 5
    serverLabel.Font.Size = 9
    serverLabel.Font.Style = "[fsBold]"
    serverLabel.Font.Color = 0xDC5EFF

    serverComboBox = createComboBox(wpContent)
    serverComboBox.Left = 15
    serverComboBox.Top = 28
    serverComboBox.Width = 195
    serverComboBox.Style = csDropDownList
    serverComboBox.OnChange = function()
        if serverComboBox.ItemIndex &gt;= 0 then
            currentServer = serverComboBox.Items[serverComboBox.ItemIndex]
            refreshWaypointList()
        end
    end

    local addServerButton = createButton(wpContent)
    addServerButton.Caption = "+ ADD"
    addServerButton.Left = 220
    addServerButton.Top = 26
    addServerButton.Width = 55
    addServerButton.Height = 26
    addServerButton.Font.Size = 9
    addServerButton.Color = 0x1F1F1F
    addServerButton.Font.Color = 0xDC5EFF
    addServerButton.OnClick = function()
        local name = inputQuery("Add Server/Folder", "Enter server or folder name:", "")
        if name and name ~= "" then
            addServer(name)
            currentServer = name
            refreshServerList()
            refreshWaypointList()
        end
    end

    local deleteServerButton = createButton(wpContent)
    deleteServerButton.Caption = "- DEL"
    deleteServerButton.Left = 285
    deleteServerButton.Top = 26
    deleteServerButton.Width = 55
    deleteServerButton.Height = 26
    deleteServerButton.Font.Size = 9
    deleteServerButton.Color = 0x1F1F1F
    deleteServerButton.Font.Color = 0xFF5555
    deleteServerButton.OnClick = function()
        if serverComboBox.ItemIndex &gt;= 0 then
            local serverName = serverComboBox.Items[serverComboBox.ItemIndex]
            if serverName ~= "Default" then
                deleteServer(serverName)
                refreshServerList()
                refreshWaypointList()
                setStatus("Server deleted: " .. serverName, false)
            else
                setStatus("Cannot delete Default folder", true)
            end
        end
    end

    -- Waypoints section
    local waypointsLabel = createLabel(wpContent)
    waypointsLabel.Caption = "WAYPOINTS"
    waypointsLabel.Left = 15
    waypointsLabel.Top = 65
    waypointsLabel.Font.Size = 9
    waypointsLabel.Font.Style = "[fsBold]"
    waypointsLabel.Font.Color = 0xDC5EFF

    waypointListBox = createListBox(wpContent)
    waypointListBox.Left = 15
    waypointListBox.Top = 88
    waypointListBox.Width = 320
    waypointListBox.Height = 180
    waypointListBox.Color = 0x151515
    waypointListBox.Font.Color = 0xFFFFFF

    local loadWaypointButton = createButton(wpContent)
    loadWaypointButton.Caption = "LOAD SELECTED"
    loadWaypointButton.Left = 15
    loadWaypointButton.Top = 280
    loadWaypointButton.Width = 155
    loadWaypointButton.Height = 35
    loadWaypointButton.Font.Size = 10
    loadWaypointButton.Font.Style = "[fsBold]"
    loadWaypointButton.Color = 0xDC5EFF
    loadWaypointButton.Font.Color = 0xFFFFFF
    loadWaypointButton.OnClick = function()
        local index = waypointListBox.ItemIndex
        if index &gt;= 0 and waypointsData[currentServer] and waypointsData[currentServer][index + 1] then
            local waypoint = waypointsData[currentServer][index + 1]
            xInput.Text = string.format("%.2f", waypoint.x)
            yInput.Text = string.format("%.2f", waypoint.y)
            zInput.Text = string.format("%.2f", waypoint.z)
            setStatus("Loaded waypoint: " .. waypoint.name, false)
        end
    end

    local deleteWaypointButton = createButton(wpContent)
    deleteWaypointButton.Caption = "DELETE"
    deleteWaypointButton.Left = 180
    deleteWaypointButton.Top = 280
    deleteWaypointButton.Width = 155
    deleteWaypointButton.Height = 35
    deleteWaypointButton.Font.Size = 10
    deleteWaypointButton.Font.Style = "[fsBold]"
    deleteWaypointButton.Color = 0xFF5555
    deleteWaypointButton.Font.Color = 0xFFFFFF
    deleteWaypointButton.OnClick = function()
        local index = waypointListBox.ItemIndex
        if index &gt;= 0 then
            deleteWaypoint(currentServer, index + 1)
            refreshWaypointList()
            setStatus("Waypoint deleted", false)
        end
    end

    local saveCurrentPosButton = createButton(wpContent)
    saveCurrentPosButton.Caption = "SAVE CURRENT POS"
    saveCurrentPosButton.Left = 15
    saveCurrentPosButton.Top = 325
    saveCurrentPosButton.Width = 320
    saveCurrentPosButton.Height = 35
    saveCurrentPosButton.Font.Size = 10
    saveCurrentPosButton.Font.Style = "[fsBold]"
    saveCurrentPosButton.Color = 0x1F1F1F
    saveCurrentPosButton.Font.Color = 0xDC5EFF
    saveCurrentPosButton.OnClick = function()
        local x, y, z = readCoordinates()
        if x then
            local name = inputQuery("Save Waypoint", "Enter waypoint name:", "")
            if name and name ~= "" then
                addWaypoint(currentServer, name, x, y, z)
                refreshWaypointList()
                setStatus("Waypoint saved: " .. name, false)
            end
        else
            setStatus("Player not found!", true)
        end
    end

    waypointsForm.OnClose = function()
        waypointsForm.hide()
        return caHide
    end

    -- Keep window on top
    local function setWpTopmost()
        local handle = waypointsForm.Handle
        if handle then
            pcall(winapi_SetWindowPos, handle, -1, 0, 0, 0, 0, 0x0003)
        end
    end
    pcall(setWpTopmost)

    local wpTopmostTimer = createTimer(waypointsForm)
    wpTopmostTimer.Interval = 2000
    wpTopmostTimer.OnTimer = function()
        pcall(setWpTopmost)
    end
    wpTopmostTimer.Enabled = true

    refreshServerList()
    refreshWaypointList()
    waypointsForm.show()
end

waypointsButton.OnClick = function()
    showWaypointsWindow()
end

--============================================
-- COORDINATE FUNCTIONS
--============================================

function readCoordinates()
    if not isConnected then
        return nil, nil, nil
    end

    local xAddr, yAddr, zAddr, usingSymbol = getCoordPointers()

    local successX, x = pcall(readFloat, xAddr)
    if not successX or not x then
        return nil, nil, nil
    end

    local successY, y = pcall(readFloat, yAddr)
    if not successY or not y then
        return nil, nil, nil
    end

    local successZ, z = pcall(readFloat, zAddr)
    if not successZ or not z then
        return nil, nil, nil
    end

    return x, y, z
end

function writeCoordinates(x, y, z)
    if not isConnected then
        return false
    end

    local xAddr, yAddr, zAddr, usingSymbol = getCoordPointers()
    pcall(writeFloat, xAddr, x)
    pcall(writeFloat, yAddr, y)
    pcall(writeFloat, zAddr, z)
    return true
end

function updatePositionDisplay()
    if not isConnected then
        positionDisplay.Caption = "Not connected to game"
        positionDisplay.Font.Color = 0x606060
        return
    end

    local x, y, z = readCoordinates()
    if x then
        positionDisplay.Caption = string.format("X: %.1f | Y: %.1f | Z: %.1f", x, y, z)
        coordinatesLabel.Caption = string.format("X: %.1f | Y: %.1f | Z: %.1f", x, y, z)
        positionDisplay.Font.Color = 0xDC5EFF
    else
        positionDisplay.Caption = "Player not found"
        positionDisplay.Font.Color = 0x606060
    end
end

--============================================
-- TELEPORT FUNCTIONS
--============================================

function sleepWithMessages(duration)
    local endTime = getTickCount() + duration
    while getTickCount() &lt; endTime do
        sleep(10)
        if processMessages then
            processMessages()
        end
        if cancelTeleport then
            return false
        end
    end
    return true
end

function holdPosition(x, y, z, duration)
    local endTime = getTickCount() + duration
    while getTickCount() &lt; endTime do
        if cancelTeleport then
            return false
        end
        writeCoordinates(x, y, z)
        sleep(10)
        if processMessages then
            processMessages()
        end
    end
    return true
end

local wasFlightEnabled = false

function bypassTeleport(targetX, targetY, targetZ, travelY, stepSize, stepDelay, freezeTime)
    isTeleporting = true
    cancelTeleport = false
    cancelButton.Visible = true
    teleportButton.Visible = false
    waypointsButton.Visible = false

    -- Enable flight if not already
    if not cheatsEnabled.flight then
        cheatsEnabled.flight = true
        flightToggle.button.Caption = "ON"
        flightToggle.button.Font.Color = 0x55FF55
        flightToggle.accent.Color = 0xDC5EFF
    end

    local tolerance = 5
    local currentX, currentY, currentZ = readCoordinates()

    if currentX == nil then
        if not wasFlightEnabled then
            cheatsEnabled.flight = false
            flightToggle.button.Caption = "OFF"
            flightToggle.button.Font.Color = 0x606060
            flightToggle.accent.Color = 0x252525
        end
        setStatus("Player not found!", true)
        isTeleporting = false
        cancelButton.Visible = false
        teleportButton.Visible = true
        waypointsButton.Visible = true
        return false
    end

    -- Move to travel height
    setStatus("Moving to Y=" .. math.floor(travelY) .. "...", false)
    if not holdPosition(currentX, travelY, currentZ, freezeTime) then
        isTeleporting = false
        cancelButton.Visible = false
        teleportButton.Visible = true
        waypointsButton.Visible = true
        return false
    end

    -- Move horizontally in steps
    local posX, posZ = currentX, currentZ
    local stepCount = 0

    while true do
        if cancelTeleport then
            if not wasFlightEnabled then
                cheatsEnabled.flight = false
                flightToggle.button.Caption = "OFF"
                flightToggle.button.Font.Color = 0x606060
                flightToggle.accent.Color = 0x252525
            end
            isTeleporting = false
            cancelButton.Visible = false
            teleportButton.Visible = true
            waypointsButton.Visible = true
            return false
        end

        local deltaX = targetX - posX
        local deltaZ = targetZ - posZ
        local distance = math.sqrt(deltaX^2 + deltaZ^2)
        stepCount = stepCount + 1

        setStatus(string.format("Step %d: %.0f units left", stepCount, distance), false)

        if distance &lt;= tolerance then
            break
        end

        local moveDistance = math.min(stepSize, distance)
        if distance &gt; 0 then
            posX = posX + deltaX / distance * moveDistance
            posZ = posZ + deltaZ / distance * moveDistance
        end

        if not holdPosition(posX, travelY, posZ, stepDelay) then
            if not wasFlightEnabled then
                cheatsEnabled.flight = false
                flightToggle.button.Caption = "OFF"
                flightToggle.button.Font.Color = 0x606060
                flightToggle.accent.Color = 0x252525
            end
            isTeleporting = false
            cancelButton.Visible = false
            teleportButton.Visible = true
            waypointsButton.Visible = true
            return false
        end

        updatePositionDisplay()
    end

    -- Align to exact target X/Z
    setStatus("Aligning to target...", false)
    if not holdPosition(targetX, travelY, targetZ, stepDelay) then
        if not wasFlightEnabled then
            cheatsEnabled.flight = false
            flightToggle.button.Caption = "OFF"
            flightToggle.button.Font.Color = 0x606060
            flightToggle.accent.Color = 0x252525
        end
        isTeleporting = false
        cancelButton.Visible = false
        teleportButton.Visible = true
        waypointsButton.Visible = true
        return false
    end

    -- Move to final Y
    setStatus("Teleporting to final...", false)
    if not holdPosition(targetX, targetY, targetZ, freezeTime) then
        if not wasFlightEnabled then
            cheatsEnabled.flight = false
            flightToggle.button.Caption = "OFF"
            flightToggle.button.Font.Color = 0x606060
            flightToggle.accent.Color = 0x252525
        end
        isTeleporting = false
        cancelButton.Visible = false
        teleportButton.Visible = true
        waypointsButton.Visible = true
        return false
    end

    sleep(50)

    -- Verify final position
    local finalX, finalY, finalZ = readCoordinates()
    if finalX then
        local err = math.sqrt((finalX - targetX)^2 + (finalY - targetY)^2 + (finalZ - targetZ)^2)
        if err &lt;= tolerance then
            setStatus(string.format("Arrived! (%.0f, %.0f, %.0f)", finalX, finalY, finalZ), false)
        else
            setStatus(string.format("Near target (%.0f off)", err), false)
        end
    end

    -- Restore flight state
    if not wasFlightEnabled then
        cheatsEnabled.flight = false
        flightToggle.button.Caption = "OFF"
        flightToggle.button.Font.Color = 0x606060
        flightToggle.accent.Color = 0x252525
    end

    isTeleporting = false
    cancelButton.Visible = false
    teleportButton.Visible = true
    waypointsButton.Visible = true
    updatePositionDisplay()
    return true
end

teleportButton.OnClick = function()
    if not isConnected then
        setStatus("Not connected!", true)
        return
    end

    if isTeleporting then
        setStatus("Already teleporting!", true)
        return
    end

    local targetX = tonumber(xInput.Text)
    local targetY = tonumber(yInput.Text)
    local targetZ = tonumber(zInput.Text)
    local freezeTime = tonumber(freezeInput.Text) or 500
    local travelY = tonumber(travelYInput.Text) or 150
    local stepSize = tonumber(stepInput.Text) or 25
    local stepDelay = tonumber(delayInput.Text) or 100

    if not targetX or not targetY or not targetZ then
        setStatus("Invalid coordinates!", true)
        return
    end

    local currentX, currentY, currentZ = readCoordinates()
    if not currentX then
        setStatus("Player not found!", true)
        return
    end

    wasFlightEnabled = cheatsEnabled.flight

    -- Enable flight for teleport
    if not wasFlightEnabled then
        cheatsEnabled.flight = true
        flightToggle.button.Caption = "ON"
        flightToggle.button.Font.Color = 0x55FF55
        flightToggle.accent.Color = 0xDC5EFF
    end

    setStatus("Teleporting...", false)

    -- Try direct teleport first
    local startTime = getTickCount()
    local endTime = startTime + freezeTime
    while getTickCount() &lt; endTime do
        writeCoordinates(targetX, targetY, targetZ)
        sleep(1)
    end

    sleep(50)

    -- Check if direct teleport worked
    local finalX, finalY, finalZ = readCoordinates()
    if finalX then
        local err = math.sqrt((finalX - targetX)^2 + (finalY - targetY)^2 + (finalZ - targetZ)^2)
        if err &lt; 5 then
            if not wasFlightEnabled then
                cheatsEnabled.flight = false
                flightToggle.button.Caption = "OFF"
                flightToggle.button.Font.Color = 0x606060
                flightToggle.accent.Color = 0x252525
            end
            setStatus(string.format("Teleported! (%.0f, %.0f, %.0f)", finalX, finalY, finalZ), false)
            updatePositionDisplay()
            return
        end
    end

    -- Direct teleport blocked, use bypass
    setStatus("Blocked! Bypass...", false)
    sleep(200)
    bypassTeleport(targetX, targetY, targetZ, travelY, stepSize, stepDelay, freezeTime)
end

quickSaveButton.OnClick = function()
    local x, y, z = readCoordinates()
    if x then
        savedX, savedY, savedZ = x, y, z
        setStatus(string.format("Saved: %.0f, %.0f, %.0f", x, y, z), false)
    else
        setStatus("Player not found!", true)
    end
end

quickLoadButton.OnClick = function()
    xInput.Text = string.format("%.2f", savedX)
    yInput.Text = string.format("%.2f", savedY)
    zInput.Text = string.format("%.2f", savedZ)
    setStatus("Position loaded", false)
end

xInput.OnDblClick = function()
    local x, y, z = readCoordinates()
    if x then
        xInput.Text = string.format("%.2f", x)
        yInput.Text = string.format("%.2f", y)
        zInput.Text = string.format("%.2f", z)
        setStatus("Current position loaded", false)
    else
        setStatus("Player not found!", true)
    end
end

--============================================
-- PROCESS ATTACHMENT
--============================================

function autoAttach()
    local processNames = {"HytaleClient.exe", "Hytale.exe"}

    for _, processName in ipairs(processNames) do
        local pid = getProcessIDFromProcessName(processName)
        if pid and pid ~= 0 then
            openProcess(pid)
            processId = pid
            updateConnectionStatus(true)
            setStatus("Connected to " .. processName, false)
            initializeAOBScans()
            return true
        end
    end

    updateConnectionStatus(false)
    setStatus("Waiting for Hytale...", true)
    return false
end

function checkConnection()
    if processId then
        local stillRunning = false
        local processNames = {"HytaleClient.exe", "Hytale.exe"}

        for _, processName in ipairs(processNames) do
            local pid = getProcessIDFromProcessName(processName)
            if pid and pid == processId then
                stillRunning = true
                break
            end
        end

        if not stillRunning then
            updateConnectionStatus(false)
            processId = nil
            aobScansInitialized = false
            setStatus("Game closed - Waiting...", true)
            return false
        end
        return true
    end
    return false
end

--============================================
-- TIMERS
--============================================

-- Cheat application timer
local cheatTimer = createTimer(mainForm)
cheatTimer.Interval = 100
cheatTimer.OnTimer = function()
    if not isConnected then
        return
    end

    -- Flight
    local flightAddr = getAddressSafe('[flight]+A7')
    if flightAddr then
        pcall(writeByte, flightAddr, cheatsEnabled.flight and 1 or 0)
    end

    -- No Clip
    local noclipAddr = getAddressSafe('[flight]+71')
    if noclipAddr then
        pcall(writeByte, noclipAddr, cheatsEnabled.noclip and 1 or 0)
    end

    -- Speed Boost
    local speedAddr = getAddressSafe('[pCords]+430')
    if speedAddr then
        pcall(writeFloat, speedAddr, cheatsEnabled.speedBoost and speedMultiplier or 1)
    end

    -- Infinite Stamina
    local staminaAddr = getAddressSafe('[stamina]+10')
    if staminaAddr and cheatsEnabled.infiniteStamina then
        pcall(writeFloat, staminaAddr, 10)
    end

    -- Creative Mode
    local gamemodeAddr = getAddressSafe('[gamemode]+A')
    if gamemodeAddr then
        pcall(writeByte, gamemodeAddr, cheatsEnabled.creativeMode and 1 or 0)
    end
end
cheatTimer.Enabled = true

-- Connection check timer
local connectionTimer = createTimer(mainForm)
connectionTimer.Interval = 2000
connectionTimer.OnTimer = function()
    if not isConnected then
        autoAttach()
    else
        checkConnection()
    end
end
connectionTimer.Enabled = true

-- Position update timer
local positionTimer = createTimer(mainForm)
positionTimer.Interval = 250
positionTimer.OnTimer = function()
    if not isTeleporting then
        updatePositionDisplay()
    end
end
positionTimer.Enabled = true

--============================================

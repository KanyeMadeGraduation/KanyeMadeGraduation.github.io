--============================================
-- HYTALE TRAINER by Urbanstorm
--============================================

local aobScansInitialized = false

function initializeAOBScans()
    if aobScansInitialized then
        return true
    end

    local assemblyScript = [[
        aobscanmodule(player_flight,HytaleClient.exe,)
        alloc(newmemplayer_flight,$100,player_flight)
        alloc(flight,8,player_flight)
        label(codeplayer_flight returnplayer_flight)

        newmemplayer_flight:
        mov [flight],rbx

        codeplayer_flight:
        cmp byte ptr [rbx+000000A7],00
        jmp returnplayer_flight

        player_flight:
        jmp newmemplayer_flight
        nop 2
        returnplayer_flight:
        registersymbol(player_flight flight)

        aobscanmodule(player_vel,HytaleClient.exe,F3 * * * * * * * F3 * * * F3 * * * * * * * F3 * * * F3 * * * F3 * * * F3 * * * * * 80 * * * * * * 0F)
        alloc(newmemplayer_vel,$100,player_vel)
        alloc(vel,8,player_vel)
        label(codeplayer_vel returnplayer_vel)

        newmemplayer_vel:
        mov [vel],rbx

        codeplayer_vel:
        movss xmm0,[rbx+000000E0]
        jmp returnplayer_vel

        player_vel:
        jmp newmemplayer_vel
        nop 3
        returnplayer_vel:
        registersymbol(player_vel vel)

        aobscanmodule(player_pCords,HytaleClient.exe,0F12xxxxxxxxxx0F28xxF3xxxxxxF3xxxxxxE8)
        alloc(newmemplayer_pCords,$100,player_pCords)
        alloc(pCords,8,player_pCords)
        label(codeplayer_pCords returnplayer_pCords)

        newmemplayer_pCords:
        mov [pCords],rax

        codeplayer_pCords:
        movlps xmm6,[rax+0000027C]
        jmp returnplayer_pCords

        player_pCords:
        jmp newmemplayer_pCords
        nop 2
        returnplayer_pCords:
        registersymbol(player_pCords pCords)

        aobscanmodule(player_fov,HytaleClient.exe,F3xxxxxxxxxxxxxx0F28xxF3xxxxxx0F54xxxxxxxxxxF3xxxxxxxxxxxxxx0F2Exx76xxF3xxxxxxxxxxxxxx0F28)
        alloc(newmemplayer_fov,$100,player_fov)
        alloc(fov,8,player_fov)
        alloc(fov_valv,8,player_fov)
        label(codeplayer_fov returnplayer_fov)

        fov_valv:
        dq (float)90

        newmemplayer_fov:
        mov [fov],rcx
        movss xmm1,[fov_valv]
        jmp returnplayer_fov

        codeplayer_fov:
        movss xmm1,[rcx+00000214]
        jmp returnplayer_fov

        player_fov:
        jmp newmemplayer_fov
        nop 3
        returnplayer_fov:
        registersymbol(player_fov fov fov_valv)

        aobscanmodule(effecttime,HytaleClient.exe,F3 * * * * 48 * * * 48 * * * * * * 39 * 48 * * * 5B E9)
        alloc(newmemeffecttime,$100,effecttime)
        alloc(time,8,effecttime)
        alloc(custom_time,8,effecttime)
        label(codeeffecttime returneffecttime)

        newmemeffecttime:
        mov [time],rbx
        push rsi
        mov rsi,[rbx+20]
        mov [custom_time],rsi
        movss xmm0,[custom_time]
        pop rsi

        codeeffecttime:
        movss [rbx+20],xmm0
        jmp returneffecttime

        effecttime:
        jmp newmemeffecttime
        returneffecttime:
        registersymbol(effecttime time custom_time)

        aobscanmodule(setGamemode,HytaleClient.exe,80xxxxxx74xx488Bxxxx4038)
        aobscanmodule(jeaddress,HytaleClient.exe,B8xxxxxxxx4883xxxx5B5EC3909090909055)
        alloc(newmemsetGamemode,$100,setGamemode)
        alloc(gamemode,8,setGamemode)
        label(codesetGamemode returnsetGamemode)

        newmemsetGamemode:
        mov [gamemode],rcx

        codesetGamemode:
        cmp byte ptr [rcx+0A],01
        je jeaddress
        jmp returnsetGamemode

        setGamemode:
        jmp newmemsetGamemode
        nop 1
        returnsetGamemode:
        registersymbol(setGamemode jeaddress gamemode)

        aobscanmodule(player_stamina,HytaleClient.exe,F3xxxxxxxxF3xxxxxxxxF3xxxxxxxxF3xxxxxxxx0F2E)
        alloc(newmemplayer_stamina,$100,player_stamina)
        alloc(stamina,8,player_stamina)
        label(codeplayer_stamina returnplayer_stamina)

        newmemplayer_stamina:
        cmp [rbp+13c],0
        jne codeplayer_stamina
        mov [stamina],rbp
        mov [rbp+10],(float)10

        codeplayer_stamina:
        movss xmm0,[rbp+10]
        jmp returnplayer_stamina

        player_stamina:
        jmp newmemplayer_stamina
        returnplayer_stamina:
        registersymbol(player_stamina stamina)
    ]]

    local success, result = pcall(autoAssemble, assemblyScript)
    if success then
        aobScansInitialized = true
        return true
    end
    return false
end

--============================================
-- WAYPOINTS SYSTEM
--============================================

local waypointsFilePath = getCheatEngineDir() .. "Hytale_Waypoints.txt"
local waypointsData = {}
local currentServer = "Default"

function loadWaypoints()
    waypointsData = {}

    if fileExists(waypointsFilePath) then
        local file = io.open(waypointsFilePath, "r")
        if file then
            local content = file:read("*all")
            file:close()

            for serverName, waypointName, xCoord, yCoord, zCoord in content:gmatch("([^|]+)|([^,]+),([^,]+),([^,]+),([^\n]+)\n?") do
                if not waypointsData[serverName] then
                    waypointsData[serverName] = {}
                end
                table.insert(waypointsData[serverName], {
                    name = waypointName,
                    x = tonumber(xCoord),
                    y = tonumber(yCoord),
                    z = tonumber(zCoord)
                })
            end
        end
    end

    if not waypointsData["Default"] then
        waypointsData["Default"] = {}
    end
end

function saveWaypoints()
    local file = io.open(waypointsFilePath, "w")
    if file then
        for serverName, waypoints in pairs(waypointsData) do
            for index, waypoint in ipairs(waypoints) do
                file:write(string.format("%s|%s,%.3f,%.3f,%.3f\n", serverName, waypoint.name, waypoint.x, waypoint.y, waypoint.z))
            end
        end
        file:close()
    end
end

function addWaypoint(serverName, waypointName, x, y, z)
    if not waypointsData[serverName] then
        waypointsData[serverName] = {}
    end
    table.insert(waypointsData[serverName], {
        name = waypointName,
        x = x,
        y = y,
        z = z
    })
    saveWaypoints()
end

function deleteWaypoint(serverName, index)
    if waypointsData[serverName] and waypointsData[serverName][index] then
        table.remove(waypointsData[serverName], index)
        saveWaypoints()
    end
end

function addServer(serverName)
    if not waypointsData[serverName] then
        waypointsData[serverName] = {}
        saveWaypoints()
    end
end

function deleteServer(serverName)
    if waypointsData[serverName] then
        waypointsData[serverName] = nil
        saveWaypoints()
        if currentServer == serverName then
            currentServer = "Default"
        end
    end
end

function getServerList()
    local serverList = {}
    for serverName, _ in pairs(waypointsData) do
        table.insert(serverList, serverName)
    end
    table.sort(serverList)
    return serverList
end

loadWaypoints()


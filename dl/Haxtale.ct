local teleportTab = tabPanels[3]

-- Coordinate pointer paths
local coordPointerX = "[[[[[THREADSTACK0-4B0]+8]+88]+10]+10]+27C"
local coordPointerY = "[[[[[THREADSTACK0-4B0]+8]+88]+10]+10]+280"
local coordPointerZ = "[[[[[THREADSTACK0-4B0]+8]+88]+10]+10]+284"

function getCoordPointers()
    local xAddr = getAddressSafe('[pCords]+27C')
    local yAddr = getAddressSafe('[pCords]+280')
    local zAddr = getAddressSafe('[pCords]+284')

    if xAddr and yAddr and zAddr then
        return xAddr, yAddr, zAddr, true
    end
    return coordPointerX, coordPointerY, coordPointerZ, false
end


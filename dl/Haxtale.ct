-- Header drag events
headerPanel.OnMouseDown = function(sender, button, x, y)
    if button == mbLeft then
        startDrag(mainForm.Left + x, mainForm.Top + y)
    end
end

headerPanel.OnMouseMove = function(sender, x, y)
    doDrag(mainForm.Left + x, mainForm.Top + y)
end

headerPanel.OnMouseUp = function(sender, button)
    if button == mbLeft then
        stopDrag()
    end
end

titleLabel.OnMouseDown = function(sender, button, x, y)
    if button == mbLeft then
        startDrag(mainForm.Left + titleLabel.Left + x, mainForm.Top + titleLabel.Top + y)
    end
end

titleLabel.OnMouseMove = function(sender, x, y)
    doDrag(mainForm.Left + titleLabel.Left + x, mainForm.Top + titleLabel.Top + y)
end


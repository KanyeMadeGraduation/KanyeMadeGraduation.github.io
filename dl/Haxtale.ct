--============================================
-- TAB SYSTEM
--============================================

local tabBarPanel = createPanel(mainForm)
tabBarPanel.Left = 0
tabBarPanel.Top = 60
tabBarPanel.Width = 440
tabBarPanel.Height = 45
tabBarPanel.Color = 0x111111
tabBarPanel.BevelOuter = "bvNone"

local tabNames = {"MOVEMENT", "PLAYER", "TELEPORT"}
local tabLabels = {}
local tabPanels = {}
local tabIndicators = {}

function switchTab(index)
    currentTab = index
    for i, label in ipairs(tabLabels) do
        if i == index then
            label.Font.Color = 0xDC5EFF
            tabIndicators[i].Color = 0xDC5EFF
        else
            label.Font.Color = 0x606060
            tabIndicators[i].Color = 0x111111
        end
    end
    for i, panel in ipairs(tabPanels) do
        panel.Visible = (i == index)
    end
end

local tabWidth = 130
local tabStartX = 15

for i, name in ipairs(tabNames) do
    local label = createLabel(tabBarPanel)
    label.Caption = name
    label.Left = tabStartX + (i - 1) * (tabWidth + 10)
    label.Top = 10
    label.Width = tabWidth
    label.Height = 20
    label.Font.Size = 10
    label.Font.Style = "[fsBold]"
    label.Font.Color = (i == 1) and 0xDC5EFF or 0x606060
    label.Alignment = "taCenter"
    label.Transparent = true
    label.OnClick = function()
        switchTab(i)
    end
    tabLabels[i] = label

    local indicator = createPanel(tabBarPanel)
    indicator.Left = tabStartX + (i - 1) * (tabWidth + 10)
    indicator.Top = 38
    indicator.Width = tabWidth
    indicator.Height = 3
    indicator.Color = (i == 1) and 0xDC5EFF or 0x111111
    indicator.BevelOuter = "bvNone"
    tabIndicators[i] = indicator
end


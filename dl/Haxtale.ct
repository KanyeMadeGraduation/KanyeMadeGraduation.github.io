--============================================
-- KEEP WINDOW ON TOP
--============================================

local function setTopmost()
    local handle = mainForm.Handle
    if handle then
        pcall(winapi_SetWindowPos, handle, -1, 0, 0, 0, 0, 0x0003)
    end
end
pcall(setTopmost)

local topmostTimer = createTimer(mainForm)
topmostTimer.Interval = 2000
topmostTimer.OnTimer = function()
    pcall(setTopmost)
end
topmostTimer.Enabled = true

--============================================
-- INITIALIZATION
--============================================

autoAttach()
updatePositionDisplay()
mainForm.Show()
</LuaScript>
</CheatTable>